{
  "name": "@e22m4u/js-repository",
  "version": "0.8.5",
  "description": "Реализация репозитория для работы с базами данных",
  "author": "Mikhail Evstropov <e22m4u@yandex.ru>",
  "license": "MIT",
  "keywords": [
    "Repository",
    "ORM",
    "ODM",
    "Database",
    "Datasource",
    "Relations"
  ],
  "homepage": "https://gitverse.ru/e22m4u/js-repository",
  "repository": {
    "type": "git",
    "url": "git+https://gitverse.ru/e22m4u/js-repository.git"
  },
  "type": "module",
  "types": "./src/index.d.ts",
  "module": "./src/index.js",
  "main": "./dist/cjs/index.cjs",
  "exports": {
    "types": "./src/index.d.ts",
    "import": "./src/index.js",
    "require": "./dist/cjs/index.cjs"
  },
  "engines": {
    "node": ">=12"
  },
  "scripts": {
    "lint": "tsc && eslint ./src",
    "lint:fix": "tsc && eslint ./src --fix",
    "format": "prettier --write \"./src/**/*.js\"",
    "test": "npm run lint && c8 --reporter=text-summary mocha --bail",
    "test:coverage": "npm run lint && c8 --reporter=text mocha --bail",
    "build:cjs": "rimraf ./dist/cjs && node build-cjs.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@e22m4u/js-format": "~0.4.0",
    "@e22m4u/js-service": "~0.6.1"
  },
  "devDependencies": {
    "@commitlint/cli": "~20.4.3",
    "@commitlint/config-conventional": "~20.4.3",
    "@e22m4u/js-spy": "~0.3.6",
    "@eslint/js": "~9.39.2",
    "@types/chai": "~5.2.3",
    "@types/chai-as-promised": "~8.0.2",
    "@types/mocha": "~10.0.10",
    "c8": "~11.0.0",
    "chai": "~6.2.2",
    "chai-as-promised": "~8.0.2",
    "esbuild": "~0.27.3",
    "eslint": "~9.39.2",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-chai-expect": "~3.1.0",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-jsdoc": "~62.7.1",
    "eslint-plugin-mocha": "~11.2.0",
    "husky": "~9.1.7",
    "mocha": "~11.7.5",
    "prettier": "~3.8.1",
    "rimraf": "~6.1.3",
    "typescript": "~5.9.3"
  }
}
