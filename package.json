{
  "name": "@e22m4u/js-repository",
  "version": "0.7.0",
  "description": "Реализация репозитория для работы с базами данных",
  "author": "Mikhail Evstropov <e22m4u@yandex.ru>",
  "license": "MIT",
  "keywords": [
    "Repository",
    "ORM",
    "ODM",
    "Database",
    "Datasource",
    "Relations"
  ],
  "homepage": "https://gitrepos.ru/e22m4u/js-repository",
  "repository": {
    "type": "git",
    "url": "git+https://gitrepos.ru/e22m4u/js-repository.git"
  },
  "type": "module",
  "module": "./src/index.js",
  "main": "./dist/cjs/index.cjs",
  "exports": {
    "import": "./src/index.js",
    "require": "./dist/cjs/index.cjs"
  },
  "engines": {
    "node": ">=12"
  },
  "scripts": {
    "lint": "eslint ./src",
    "lint:fix": "eslint ./src --fix",
    "format": "prettier --write \"./src/**/*.js\"",
    "test": "npm run lint && c8 --reporter=text-summary mocha --bail",
    "test:coverage": "npm run lint && c8 --reporter=text mocha --bail",
    "build:cjs": "rimraf ./dist/cjs && node build-cjs.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@e22m4u/js-empty-values": "~0.2.0",
    "@e22m4u/js-format": "~0.3.0",
    "@e22m4u/js-service": "~0.4.6"
  },
  "devDependencies": {
    "@commitlint/cli": "~20.1.0",
    "@commitlint/config-conventional": "~20.0.0",
    "c8": "~10.1.3",
    "chai": "~6.2.1",
    "chai-as-promised": "~8.0.2",
    "chai-spies": "~1.1.0",
    "esbuild": "~0.27.0",
    "eslint": "~9.39.1",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-chai-expect": "~3.1.0",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-jsdoc": "~61.4.1",
    "eslint-plugin-mocha": "~11.2.0",
    "husky": "~9.1.7",
    "mocha": "~11.7.5",
    "prettier": "~3.7.3",
    "rimraf": "~6.1.2"
  }
}
